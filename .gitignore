.DS_Store
*.log
.superpowers/
docs/superpowers/
# CE plan artifacts — session material, not kit deliverables
docs/plans/
.eval-tmp/
.worktrees/
__pycache__/
*.pyc
# Client APKs — never commit real client binaries (provenance / pseudonym rule)
apks/
# Working labs — local scratch, not kit deliverables
labs/
# Local-only Claude Code settings (per-machine permission allowlist, not shared)
.claude/settings.local.json
.claude/settings.local.json.new
# CE machine-local config (ce-setup Step 7). The sibling config.local.example.yaml
# is tracked on purpose — it documents the available settings and is NOT matched
# by this line, which requires the name to end in `.local.yaml`.
.compound-engineering/*.local.yaml
# check-provenance.sh's literal denylist (client/engagement names) — never tracked.
# .provenance-deny.example (the shipped, name-free template) is intentionally NOT
# matched by this line — it's a different filename, not a suffix of this one.
.provenance-deny
