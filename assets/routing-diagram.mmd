---
config:
  look: handDrawn
  theme: base
  flowchart:
    wrappingWidth: 220
  themeVariables:
    primaryColor: "#fefdfa"
    primaryBorderColor: "#2b2b2b"
    lineColor: "#4a453c"
    primaryTextColor: "#1a1a1a"
    clusterBkg: "#fefdfa"
    clusterBorder: "#8a8378"
    edgeLabelBackground: "#fefdfa"
    fontFamily: "Comic Sans MS, Chalkboard SE, Comic Neue, cursive"
---
%% agent-kit routing map — how you enter the kit and who conducts each stage.
%% Canonical light source. The dark variant (routing-diagram-dark.svg) is the
%% same graph re-rendered with only the themeVariables palette swapped:
%%   primaryColor        #fefdfa -> #1a1a1a
%%   primaryBorderColor  #2b2b2b -> #c9c2b3
%%   lineColor           #4a453c -> #c9c2b3
%%   primaryTextColor    #1a1a1a -> #f2ede2
%%   clusterBkg          #fefdfa -> #1f1f1f
%%   clusterBorder       #8a8378 -> #7d766a
%%   edgeLabelBackground #fefdfa -> #1a1a1a
%% background left unset in both (transparent) so GitHub's page color shows
%% through. No other line changes — regenerate the dark SVG by copying this
%% file, applying only the swap above, and rendering with the same mmdc config.
flowchart TB

subgraph ENTRY["Entry — three ways in"]
  direction LR
  E_LOOSE(["a loose phrase"])
  E_SLASH(["/ce-*"])
  E_ALWAYS(["always on"])
end

subgraph RAIL["Lean rail — one owner per stage, you invoke every box"]
  direction LR
  subgraph SP["superpowers"]
    DISC["Discover"]
  end
  subgraph CE["CE"]
    direction LR
    PLAN["Plan"]
    EXEC["Execute"]
    REV["Review"]
    SHIP["Ship"]
    PLAN --> EXEC --> REV --> SHIP
  end
  DISC --> PLAN
end

KIT["hooks + postures"]

TECHBD(["/core:tech-breakdown"])
ANNOT["copy-paste into /ce-plan"]

E_LOOSE ==> DISC
E_SLASH ==> PLAN
E_ALWAYS ==> KIT
RAIL -.-> KIT
TECHBD -. "no auto entry" .-> ANNOT
